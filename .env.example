# DevContinuity environment. Copy to .env.local and fill in what you need.
# Everything except AI analysis works with these left empty.

# Anthropic credentials for the optional AI features. Read only on the server;
# never sent to the browser and never written to logs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional. Where DevContinuity keeps its database, archives, exports and backups.
# Defaults to ./data inside this folder.
# DEVCONTINUITY_DATA_DIR=

# Used by the Prisma CLI for migrations (already set in .env).
# DATABASE_URL="file:../data/devcontinuity.db"

# Optional: phone access through a Cloudflare Tunnel protected by Cloudflare Access.
# Run scripts\remote-setup.ps1 first. Remote use is read-only unless enabled in Settings.
# DEVCONTINUITY_ALLOW_REMOTE=1
# DEVCONTINUITY_REMOTE_HOSTS=dc.example.com
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
