{
  "name": "devcontinuity",
  "version": "2.1.0",
  "description": "One local log for every AI coding agent: Claude Code, Codex, Antigravity, Cursor, Copilot, Cline, Gemini CLI, Windsurf and more. Search it, verify it, and continue any session with any agent.",
  "license": "MIT",
  "author": "Ahmad Albarghash",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmadrashed1999/devcontinuity.git"
  },
  "homepage": "https://github.com/ahmadrashed1999/devcontinuity#readme",
  "bugs": {
    "url": "https://github.com/ahmadrashed1999/devcontinuity/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "cline",
    "gemini-cli",
    "windsurf",
    "antigravity",
    "mcp",
    "opentelemetry",
    "developer-tools",
    "session-history",
    "local-first"
  ],
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "dc": "tsx scripts/dc.ts",
    "mcp": "tsx scripts/mcp.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "orchestrator": "tsx scripts/orchestrator.ts",
    "tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tray.ps1",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Install",
    "startup:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1 -Remove",
    "app": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
