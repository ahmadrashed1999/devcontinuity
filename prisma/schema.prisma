// DevContinuity data model.
// Full-text search lives in an FTS5 virtual table (event_fts) that is created at
// runtime by src/server/db.ts, because Prisma Migrate cannot model virtual tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Project {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  rootPath        String
  /// Lower-cased, slash-normalized rootPath used for matching.
  pathKey         String    @unique
  /// true when rootPath came from `cwd` values recorded in transcripts,
  /// false when it was only guessed from an encoded directory name.
  pathVerified    Boolean   @default(false)
  pathExists      Boolean   @default(false)
  isGitRepo       Boolean   @default(false)
  description     String?
  techStack       String?
  gitState        String?
  gitCheckedAt    DateTime?
  archived        Boolean   @default(false)
  rules           String?
  testCommand     String?
  firstActivityAt DateTime?
  lastActivityAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions Session[]
  tasks    Task[]
  docs     KnowledgeDoc[]
  items    KnowledgeItem[]
  handoffs Handoff[]
  fileOps  FileOp[]
}

model Session {
  id                    String    @id @default(cuid())
  agent                 String
  externalId            String
  projectId             String?
  title                 String?
  cwd                   String?
  worktree              String?
  gitBranch             String?
  startedAt             DateTime?
  endedAt               DateTime?
  models                String?
  primaryModel          String?
  agentVersion          String?
  isSubagent            Boolean   @default(false)
  parentExternalId      String?
  subagentId            String?
  /// completed_turn | interrupted_tool | awaiting_assistant | api_error | empty | unknown
  endState              String    @default("unknown")
  endStateDetail        String?
  eventCount            Int       @default(0)
  userMessageCount      Int       @default(0)
  assistantMessageCount Int       @default(0)
  toolCallCount         Int       @default(0)
  toolErrorCount        Int       @default(0)
  fileOpCount           Int       @default(0)
  commandCount          Int       @default(0)
  malformedLines        Int       @default(0)
  unknownRecordCount    Int       @default(0)
  firstUserPrompt       String?
  lastUserPrompt        String?
  lastAssistantText     String?
  summary               String?
  sourcePath            String
  sourceKey             String    @unique
  sourceSize            Int?
  sourceMtime           DateTime?
  sha256                String?
  archivePath           String?
  providerMeta          String?
  importedAt            DateTime  @default(now())

  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events  Event[]
  fileOps FileOp[]
  tasks   Task[]
  items   KnowledgeItem[]

  @@index([projectId, endedAt])
  @@index([agent, externalId])
  @@index([endedAt])
}

model Event {
  id          Int       @id @default(autoincrement())
  sessionId   String
  /// Position in the original source. Ordering is always by seq.
  seq         Int
  lineNo      Int?
  blockIndex  Int?
  /// user_message | assistant_message | thinking | tool_call | tool_result | system |
  /// summary | error | attachment | file_snapshot | meta | unknown
  kind        String
  role        String?
  rawType     String?
  subtype     String?
  timestamp   DateTime?
  uuid        String?
  parentUuid  String?
  text        String?
  truncated   Boolean   @default(false)
  toolName    String?
  toolUseId   String?
  isError     Boolean   @default(false)
  isSidechain Boolean   @default(false)
  isMeta      Boolean   @default(false)
  model       String?
  filePath    String?
  command     String?
  /// Byte range of the original record inside the archived source copy.
  rawOffset   Int?
  rawLength   Int?
  meta        String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@index([sessionId, kind])
  @@index([toolUseId])
  @@index([timestamp])
}

model FileOp {
  id           Int       @id @default(autoincrement())
  sessionId    String
  projectId    String?
  eventSeq     Int?
  path         String
  /// read | write | edit | notebook_edit | snapshot
  op           String
  toolName     String?
  toolUseId    String?
  timestamp    DateTime?
  /// null = no tool result was recorded, so the outcome is unknown.
  succeeded    Boolean?
  linesAdded   Int?
  linesRemoved Int?

  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, path])
  @@index([sessionId])
  @@index([toolUseId])
}

model Task {
  id               String   @id @default(cuid())
  projectId        String?
  sessionId        String?
  title            String
  description      String?
  /// completed | in_progress | pending | blocked | failed | requires_verification | cancelled
  status           String   @default("pending")
  priority         String   @default("medium")
  agent            String?
  /// user_request | agent_todo | ai_extracted | manual
  source           String   @default("manual")
  /// What the agent itself claimed. Never copied into `status` as "completed".
  aiReportedStatus String?
  /// unverified | ai_reported | evidence_found | verified | failed
  verification     String   @default("unverified")
  evidence         String?
  relatedFiles     String?
  dependencies     String?
  dedupeKey        String?  @unique
  sourceEventSeq   Int?
  manualOverride   Boolean  @default(false)
  triage           String?
  triageReason     String?
  occurredAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([sessionId])
}

model KnowledgeDoc {
  id          String   @id @default(cuid())
  projectId   String
  docType     String
  content     String
  /// generated | ai | manual
  source      String   @default("generated")
  model       String?
  generatedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, docType])
}

model KnowledgeItem {
  id         String    @id @default(cuid())
  projectId  String
  sessionId  String?
  /// decision | issue | memory | plan | note | summary
  kind       String
  title      String
  body       String
  status     String?
  /// ai | manual | agent-memory | agent-plan | transcript
  source     String    @default("manual")
  evidence   String?
  dedupeKey  String?   @unique
  occurredAt DateTime?
  createdAt  DateTime  @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId, kind])
}

model Job {
  id         String    @id @default(cuid())
  type       String
  /// queued | running | completed | failed | cancelled
  status     String    @default("queued")
  progress   Int       @default(0)
  total      Int       @default(0)
  message    String?
  log        String?
  result     String?
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([createdAt])
}

model AiCache {
  key          String   @id
  feature      String
  model        String
  output       String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([feature])
}

model Handoff {
  id          String   @id @default(cuid())
  projectId   String
  sessionId   String?
  targetAgent String
  dirPath     String
  zipPath     String?
  manifest    String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Backup {
  id               String   @id @default(cuid())
  filePath         String
  sizeMb           Float    @default(0)
  kind             String   @default("manual")
  note             String?
  includesArchives Boolean  @default(false)
  createdAt        DateTime @default(now())
}

// ======================= DevContinuity 2.0 =======================

model Secret {
  id        String   @id @default(cuid())
  name      String   @unique
  cipher    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id        String   @id @default(cuid())
  /// anthropic | openai | gemini | openrouter | deepseek | ollama | lmstudio | openai-compatible
  kind      String
  name      String
  baseUrl   String?
  /// Secret.name holding the API key, or "env:VAR" for environment variables.
  keyRef    String?
  enabled   Boolean  @default(true)
  /// Free-form list of model ids the owner wants to use with this provider.
  models    String?
  priority  Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageRecord {
  id           Int      @id @default(autoincrement())
  at           DateTime @default(now())
  providerId   String?
  providerKind String
  model        String
  job          String
  projectId    String?
  departmentId String?
  roleId       String?
  runId        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// null = price unknown for this model
  costUsd      Float?
  cached       Boolean  @default(false)

  @@index([at])
  @@index([departmentId, at])
}

model ChatThread {
  id        String        @id @default(cuid())
  title     String
  projectId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  role      String
  content   String
  sources   String?
  model     String?
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model VerificationRun {
  id         String    @id @default(cuid())
  projectId  String
  cwd        String
  command    String
  status     String    @default("running")
  exitCode   Int?
  output     String?
  durationMs Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([projectId, startedAt])
}

model Department {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  nameAr      String
  description String?
  enabled     Boolean  @default(true)
  budgetUsd   Float?
  sort        Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]
  workItems   WorkItem[]
}

model Role {
  id              String     @id @default(cuid())
  key             String     @unique
  departmentId    String
  title           String
  titleAr         String
  /// ceo | head | worker
  level           String
  reportsToKey    String?
  /// api | claude-code | codex | opencode
  executor        String     @default("api")
  /// Job route name used for API calls (plan, review, worker, cheap, strong...) or "provider:model".
  modelRoute      String     @default("worker")
  instructions    String
  /// L0 | L1 | L2 | L3 (L3 actions still always require owner approval)
  autonomy        String     @default("L1")
  allowedCommands String?
  enabled         Boolean    @default(true)
  sort            Int        @default(100)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  runs            Run[]
}

model Order {
  id          String     @id @default(cuid())
  title       String
  instruction String
  projectId   String?
  lang        String     @default("en")
  /// planning | awaiting_approval | approved | in_progress | review | done | rejected | failed | cancelled
  status      String     @default("planning")
  plan        String?
  error       String?
  costUsd     Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workItems   WorkItem[]
}

model WorkItem {
  id             String      @id @default(cuid())
  orderId        String?
  parentId       String?
  projectId      String?
  departmentId   String?
  roleKey        String?
  /// initiative | task | compare
  kind           String      @default("task")
  /// code | document
  type           String      @default("document")
  /// Executor override for this item (compare runs); null = the role's executor
  executor       String?
  title          String
  description    String?
  acceptance     String?
  dependsOn      String?
  /// planned | queued | running | head_review | qa | security_review | owner_review | changes_requested | done | rejected | failed | blocked | cancelled
  status         String      @default("planned")
  priority       Int         @default(50)
  attempts       Int         @default(0)
  result         String?
  evidence       String?
  worktreePath   String?
  branch         String?
  baseRef        String?
  costUsd        Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  order          Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  runs           Run[]

  @@index([status])
  @@index([orderId])
}

model Run {
  id         String    @id @default(cuid())
  workItemId String?
  roleId     String?
  /// work | review | qa | security | plan | summary
  purpose    String
  executor   String
  status     String    @default("running")
  log        String?
  output     String?
  error      String?
  costUsd    Float     @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  role       Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([workItemId])
}

model DecisionRequest {
  id             String    @id @default(cuid())
  /// plan_approval | merge | artifact | budget | generic | compare
  kind           String
  title          String
  question       String
  context        String?
  options        String
  recommendation String?
  risk           String?
  costUsd        Float?
  orderId        String?
  workItemId     String?
  fromRoleKey    String?
  /// pending | answered | expired
  status         String    @default("pending")
  answer         String?
  comment        String?
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  @@index([status, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  /// owner_daily | owner_weekly | department | run
  kind        String
  title       String
  content     String
  contentAr   String?
  departmentId String?
  meta        String?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

model AuditEvent {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String
  action String
  target String?
  detail String?

  @@index([at])
}

model Notification {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  level     String   @default("info")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  dedupeKey String?  @unique

  @@index([read, at])
}

model Schedule {
  id        String    @id @default(cuid())
  name      String
  /// digest_daily | digest_weekly | archive_assets | worktree_scan | verify_project | security_scan | order
  action    String
  /// JSON: { every: "day"|"week"|"hours", at?: "HH:MM", weekday?: 0-6, hours?: n }
  timing    String
  payload   String?
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  lastResult String?
  createdAt DateTime  @default(now())
}

model PromptTemplate {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("general")
  body      String
  tags      String?
  lang      String   @default("en")
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
